{
  "name": "mc-journal",
  "private": true,
  "version": "1.0.0",
  "description": "Minecraft Hardcore Journal - Pure Native Java 26 + OpenGL 3.3 Edition",
  "scripts": {
    "start": "npm run java:run",
    "dev": "npm run java:run",
    "build": "npm run java:build",
    "java:build": "javac -cp \"engine/lib/*\" -d engine/bin engine/src/com/mcjournal/*.java engine/src/com/mcjournal/client/*.java engine/src/com/mcjournal/client/gui/*.java",
    "java:run": "java -cp \"engine/bin;engine/lib/*\" com.mcjournal.client.MCJournalApp"
  }
}
