{
  "name": "mc-journal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run app:prod",
    "dev": "npm run app:prod",
    "app": "npm run java:build && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "app:prod": "npm run java:build && vite build && electron .",
    "build": "npm run java:build && vite build",
    "lint": "oxlint",
    "java:build": "javac -d engine/bin engine/src/com/mcjournal/*.java",
    "java:start": "java -cp engine/bin com.mcjournal.ChunkServer",
    "electron": "electron ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
